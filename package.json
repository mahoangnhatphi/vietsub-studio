{
  "name": "vietsub-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Phụ đề tiếng Việt, xử lý hoàn toàn trong trình duyệt.",
  "scripts": {
    "start": "npm run dev",
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d web-dist --dotfiles",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run build"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "gh-pages": "6.3.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0"
  }
}
